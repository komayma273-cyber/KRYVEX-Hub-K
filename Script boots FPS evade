local spaceFPSGui = nil
local spaceFPSRunning = false

local function createSpaceFPS()
    local parent
    pcall(function() parent = gethui and gethui() end)
    if not parent then
        pcall(function() parent = game:GetService("CoreGui") end)
    end
    if not parent then
        parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    if parent:FindFirstChild("SpaceFPS") then
        parent.SpaceFPS:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "SpaceFPS"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = parent

    local frame = Instance.new("Frame")
    frame.Name = "Main"
    frame.AnchorPoint = Vector2.new(1, 0)
    frame.Size = UDim2.fromOffset(176, 58)
    frame.Position = UDim2.new(1, -10, 0, 10)
    frame.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    frame.BackgroundTransparency = 0.05
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    frame.Parent = gui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

    local bg = Instance.new("UIGradient", frame)
    bg.Rotation = 135
    bg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(38, 38, 46)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(18, 18, 22)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(6, 6, 9)),
    })

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 1.6
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    local strokeGrad = Instance.new("UIGradient", stroke)
    strokeGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(200, 200, 215)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 60, 72)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 215)),
    })

    local rng = Random.new()
    for i = 1, 16 do
        local s = Instance.new("Frame")
        local size = rng:NextInteger(1, 2)
        s.Size = UDim2.fromOffset(size, size)
        s.Position = UDim2.new(rng:NextNumber(), 0, rng:NextNumber(), 0)
        s.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
        s.BackgroundTransparency = rng:NextNumber(0.3, 0.9)
        s.BorderSizePixel = 0
        s.ZIndex = 1
        s.Parent = frame
        Instance.new("UICorner", s).CornerRadius = UDim.new(1, 0)

        task.spawn(function()
            while s.Parent and spaceFPSRunning do
                local t = TweenService:Create(
                    s,
                    TweenInfo.new(rng:NextNumber(0.8, 2.2), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                    { BackgroundTransparency = rng:NextNumber(0.1, 0.95) }
                )
                t:Play()
                t.Completed:Wait()
            end
        end)
    end

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 3, 1, -16)
    bar.Position = UDim2.fromOffset(8, 8)
    bar.BorderSizePixel = 0
    bar.BackgroundColor3 = Color3.fromRGB(120, 255, 170)
    bar.ZIndex = 3
    bar.Parent = frame
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fpsLabel = Instance.new("TextLabel")
    fpsLabel.BackgroundTransparency = 1
    fpsLabel.Position = UDim2.fromOffset(20, 4)
    fpsLabel.Size = UDim2.fromOffset(90, 34)
    fpsLabel.Font = Enum.Font.GothamBlack
    fpsLabel.Text = "60"
    fpsLabel.TextSize = 28
    fpsLabel.TextXAlignment = Enum.TextXAlignment.Left
    fpsLabel.TextColor3 = Color3.fromRGB(235, 235, 245)
    fpsLabel.ZIndex = 3
    fpsLabel.Parent = frame

    local fpsTag = Instance.new("TextLabel")
    fpsTag.BackgroundTransparency = 1
    fpsTag.Position = UDim2.fromOffset(62, 16)
    fpsTag.Size = UDim2.fromOffset(40, 18)
    fpsTag.Font = Enum.Font.GothamBold
    fpsTag.Text = "FPS"
    fpsTag.TextSize = 11
    fpsTag.TextXAlignment = Enum.TextXAlignment.Left
    fpsTag.TextColor3 = Color3.fromRGB(140, 140, 155)
    fpsTag.ZIndex = 3
    fpsTag.Parent = frame

    local pingLabel = Instance.new("TextLabel")
    pingLabel.BackgroundTransparency = 1
    pingLabel.Position = UDim2.fromOffset(20, 36)
    pingLabel.Size = UDim2.new(1, -28, 0, 16)
    pingLabel.Font = Enum.Font.Gotham
    pingLabel.Text = "PING  -- ms"
    pingLabel.TextSize = 11
    pingLabel.TextXAlignment = Enum.TextXAlignment.Left
    pingLabel.TextColor3 = Color3.fromRGB(150, 150, 165)
    pingLabel.ZIndex = 3
    pingLabel.Parent = frame

    local planet = Instance.new("Frame")
    planet.Size = UDim2.fromOffset(22, 22)
    planet.Position = UDim2.new(1, -32, 0, 10)
    planet.BackgroundColor3 = Color3.fromRGB(90, 90, 105)
    planet.BorderSizePixel = 0
    planet.ZIndex = 3
    planet.Parent = frame
    Instance.new("UICorner", planet).CornerRadius = UDim.new(1, 0)
    local pg = Instance.new("UIGradient", planet)
    pg.Rotation = 45
    pg.Color = ColorSequence.new(Color3.fromRGB(210, 210, 225), Color3.fromRGB(25, 25, 32))

    local ring = Instance.new("Frame")
    ring.Size = UDim2.fromOffset(34, 8)
    ring.Position = UDim2.new(1, -38, 0, 17)
    ring.BackgroundTransparency = 1
    ring.Rotation = -20
    ring.ZIndex = 4
    ring.Parent = frame
    Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
    local rs = Instance.new("UIStroke", ring)
    rs.Thickness = 1.2
    rs.Color = Color3.fromRGB(170, 170, 185)
    rs.Transparency = 0.2

    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local frames, elapsed, smooth = 0, 0, 60
    task.spawn(function()
        while spaceFPSRunning and gui.Parent do
            local dt = RunService.RenderStepped:Wait()
            strokeGrad.Rotation = (strokeGrad.Rotation + dt * 60) % 360
            frames += 1
            elapsed += dt
            if elapsed >= 0.4 then
                smooth = smooth + (frames / elapsed - smooth) * 0.5
                frames, elapsed = 0, 0

                local f = math.floor(smooth + 0.5)
                fpsLabel.Text = tostring(f)

                local col
                if f >= 50 then
                    col = Color3.fromRGB(120, 255, 170)
                elseif f >= 30 then
                    col = Color3.fromRGB(255, 215, 110)
                else
                    col = Color3.fromRGB(255, 95, 95)
                end
                bar.BackgroundColor3 = col
                TweenService:Create(fpsLabel, TweenInfo.new(0.3), { TextColor3 = col:Lerp(Color3.new(1, 1, 1), 0.6) }):Play()

                local ok, ping = pcall(function()
                    return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
                pingLabel.Text = ok and ("PING  " .. math.floor(ping) .. " ms") or "PING  -- ms"
            end
        end
    end)

    spaceFPSGui = gui
end

local function startSpaceFPS()
    if spaceFPSRunning then return end
    spaceFPSRunning = true
    createSpaceFPS()
end

local function stopSpaceFPS()
    spaceFPSRunning = false
    if spaceFPSGui then
        spaceFPSGui:Destroy()
        spaceFPSGui = nil
    end
end

DisplayTab:CreateToggle({
    Name = "แสดง FPS",
    CurrentValue = false,
    Flag = "ShowFPS",
    Callback = function(value)
        if value then
            startSpaceFPS()
            notify("แสดง FPS", "เปิดใช้งาน")
        else
            stopSpaceFPS()
            notify("แสดง FPS", "ปิดใช้งาน")
