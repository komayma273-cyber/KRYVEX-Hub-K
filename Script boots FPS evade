-- =========================================
-- ฟังก์ชันปรับ Part
-- =========================================
local function smoothPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local changed = false
    if part.Material ~= Enum.Material.SmoothPlastic then
        part.Material = Enum.Material.SmoothPlastic
        changed = true
    end
    if part.Reflectance ~= 0 then
        part.Reflectance = 0
        changed = true
    end
    if part.CastShadow then
        part.CastShadow = false
        changed = true
    end
    return changed
end

local function stripDecorations(part)
    if not part or not part:IsA("BasePart") then return 0 end
    local removed = 0
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("Decal") or child:IsA("Texture")
            or child:IsA("SurfaceGui") or child:IsA("SurfaceAppearance") then
            child:Destroy()
            removed += 1
        end
    end
    return removed
end

local function isTreeModel(obj)
    if not obj or not obj:IsA("Model") then return false end
    return string.find(string.lower(obj.Name), "tree") ~= nil
end

local function isGrass(obj)
    if not obj or not obj:IsA("BasePart") then return false end
    local name = string.lower(obj.Name)
    return string.find(name, "grass") ~= nil
        or string.find(name, "weed") ~= nil
        or string.find(name, "foliage") ~= nil
        or string.find(name, "bush") ~= nil
end

local function removeTreeModel(model)
    if not isTreeModel(model) then return 0 end
    local removed = 0
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("MeshPart") then
            child:Destroy()
            removed += 1
        end
    end
    return removed
end

local function removeShadows()
    Lighting.GlobalShadows = false
    Lighting.Brightness = 1
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    Lighting.Ambient = Color3.fromRGB(128, 128, 128)
    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") then obj.Enabled = false end
    end
end

local function stripAccessories(character)
    if not character then return 0 end
    local removed = 0
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Hat")
            or obj:IsA("Shirt") or obj:IsA("Pants")
            or obj:IsA("ShirtGraphic") then
            obj:Destroy()
            removed += 1
        end
    end
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("Decal") then obj.Transparency = 1 end
    end
    return removed
end

local function stripAllPlayersAccessories()
    local total = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        total += stripAccessories(plr.Character)
    end
    return total
end

local function hideCharacter(character)
    if not character then return 0 end
    local count = 0
    for _, obj in ipairs(character:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Transparency = 1
            obj.CanCollide = false
            count += 1
        elseif obj:IsA("Decal") then
            obj.Transparency = 1
        end
    end
    return count
end

local function hideAllOtherPlayers()
    local total = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            total += hideCharacter(plr.Character)
        end
    end
    return total
end

local function removeEffects()
    local removed = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Smoke")
            or obj:IsA("Fire") or obj:IsA("Sparkles")
            or obj:IsA("Trail") or obj:IsA("Beam") then
            obj:Destroy()
            removed += 1
        end
    end
    return removed
end

-- =========================================
-- ระบบ Auto-Watch
-- =========================================
local autoWatchEnabled = false
local stripDecorationsEnabled = false
local removeTreeEnabled = false
local removeClothingEnabled = false
local hidePlayersEnabled = false
local removeEffectsEnabled = false
local watchedConnections = {}

local function watchPart(part)
    if part:GetAttribute("KRYVEX_Watched") then return end
    part:SetAttribute("KRYVEX_Watched", true)

    table.insert(watchedConnections, part:GetPropertyChangedSignal("Material"):Connect(function()
        if autoWatchEnabled and part.Material ~= Enum.Material.SmoothPlastic then
            part.Material = Enum.Material.SmoothPlastic
        end
    end))
end

local function watchDecorations(part)
    if part:GetAttribute("KRYVEX_DecoWatched") then return end
    part:SetAttribute("KRYVEX_DecoWatched", true)

    table.insert(watchedConnections, part.ChildAdded:Connect(function(child)
        if stripDecorationsEnabled and (
            child:IsA("Decal") or child:IsA("Texture")
            or child:IsA("SurfaceGui") or child:IsA("SurfaceAppearance")
        ) then
            task.defer(function()
                if child and child.Parent then child:Destroy() end
            end)
        end
    end))
end

local function watchCharacter(character)
    if not character or character:GetAttribute("KRYVEX_CharWatched") then return end
    character:SetAttribute("KRYVEX_CharWatched", true)

    table.insert(watchedConnections, character.ChildAdded:Connect(function(child)
        if removeClothingEnabled and (
            child:IsA("Accessory") or child:IsA("Hat")
            or child:IsA("Shirt") or child:IsA("Pants")
            or child:IsA("ShirtGraphic")
        ) then
            task.defer(function()
                if child and child.Parent then child:Destroy() end
            end)
        end
        if hidePlayersEnabled and character ~= LocalPlayer.Character and child:IsA("BasePart") then
            task.defer(function()
                if child and child.Parent then
                    child.Transparency = 1
                    child.CanCollide = false
                end
            end)
        end
    end))

    if hidePlayersEnabled and character ~= LocalPlayer.Character then
        hideCharacter(character)
    end
end

local function startAutoWatch(stripDeco, removeTree, removeClothing, hidePlayers, removeEffectsFlag)
    stripDecorationsEnabled = stripDeco or false
    removeTreeEnabled = removeTree or false
    removeClothingEnabled = removeClothing or false
    hidePlayersEnabled = hidePlayers or false
    removeEffectsEnabled = removeEffectsFlag or false

    if autoWatchEnabled then return end
    autoWatchEnabled = true

    task.spawn(function()
        if removeClothingEnabled then stripAllPlayersAccessories() end
        if hidePlayersEnabled then hideAllOtherPlayers() end
        if removeEffectsEnabled then removeEffects() end

        if removeTreeEnabled then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if isTreeModel(obj) then removeTreeModel(obj) end
            end
            for _, obj in ipairs(workspace:GetDescendants()) do
                if isGrass(obj) then obj:Destroy() end
            end
        end

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                smoothPart(obj)
                watchPart(obj)
                if stripDecorationsEnabled then
                    stripDecorations(obj)
                    watchDecorations(obj)
                end
            end
        end
    end)

    table.insert(watchedConnections, workspace.DescendantAdded:Connect(function(obj)
        if not autoWatchEnabled then return end

        if removeEffectsEnabled and (
            obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire")
            or obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Beam")
        ) then
            task.defer(function()
                if obj and obj.Parent then obj:Destroy() end
            end)
            return
        end

        if removeTreeEnabled and isTreeModel(obj) then
            task.defer(function()
                if obj and obj.Parent then removeTreeModel(obj) end
            end)
            return
        end

        if removeTreeEnabled and isGrass(obj) then
            task.defer(function()
                if obj and obj.Parent then obj:Destroy() end
            end)
            return
        end

        if obj:IsA("BasePart") then
            smoothPart(obj)
            watchPart(obj)
            if stripDecorationsEnabled then
                stripDecorations(obj)
                watchDecorations(obj)
            end
        elseif stripDecorationsEnabled and (
            obj:IsA("Decal") or obj:IsA("Texture")
            or obj:IsA("SurfaceGui") or obj:IsA("SurfaceAppearance")
        ) then
            task.defer(function()
                if obj and obj.Parent then obj:Destroy() end
            end)
        end
    end))

    for _, plr in ipairs(Players:GetPlayers()) do
        watchCharacter(plr.Character)
        table.insert(watchedConnections, plr.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            if removeClothingEnabled then stripAccessories(char) end
            if hidePlayersEnabled and plr ~= LocalPlayer then hideCharacter(char) end
            watchCharacter(char)
        end))
    end

    table.insert(watchedConnections, Players.PlayerAdded:Connect(function(plr)
        table.insert(watchedConnections, plr.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            if removeClothingEnabled then stripAccessories(char) end
            if hidePlayersEnabled and plr ~= LocalPlayer then hideCharacter(char) end
            watchCharacter(char)
        end))
    end))
end

