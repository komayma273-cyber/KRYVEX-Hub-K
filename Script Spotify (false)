--========= CORE =========--
local function setProgressVisual(ratio)
    Fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
end

applyFilter = function()
    local q = string.lower(SearchBox.Text)
    local any = false
    currentVisibleTrackIndices = {} -- รีเซ็ต index เพลงที่มองเห็น

    for i, r in ipairs(Rows) do
        local t = Tracks[i]
        local matchQuery = q == "" or string.find(string.lower(t.title), q, 1, true) or string.find(string.lower(t.artist), q, 1, true)
        local matchCat = (t.category == activeCategory)
        local matchLike = (not onlyLiked or liked[i])
        
        local vis = matchQuery and matchCat and matchLike
        r.frame.Visible = vis
        if vis then
            any = true
            table.insert(currentVisibleTrackIndices, i) -- เก็บ index เพลงที่โชว์อยู่
        end
    end
    NoResults.Visible = not any
    NoResults.Text = (onlyLiked and q == "") and "No liked songs yet" or "No songs found"
end

local function refreshRows()
    local count = 0
    for i, r in ipairs(Rows) do
        local cur = i == index
        r.title.TextColor3 = cur and GREEN or WHITE
        r.overlay.Visible = cur
        r.accent.Visible = cur
        r.frame.BackgroundTransparency = cur and 0.88 or 1
        r.heartIcon.ImageColor3 = liked[i] and GREEN or DIM
        local t = Tracks[i]
        r.statusLabel.Text = "●"
        r.statusLabel.TextColor3 = t.status == true and GREEN or (t.status == false and RED or STATUS_YELLOW)
        if liked[i] then count = count + 1 end
    end
    PillLiked.Text = count > 0 and ("Liked  " .. count) or "Liked"
    CountLabel.Text = "Playlist  •  " .. #Tracks .. (#Tracks == 1 and " song" or " songs")
end

local function updateLike()
    LikeIcon.ImageColor3 = liked[index] and GREEN or GRAY
    refreshRows()
    if onlyLiked then applyFilter() end
end

function toggleLike(i)
    liked[i] = not liked[i]
    updateLike()
    showToast(liked[i] == true, liked[i] and "Added to Liked Songs" or "Removed from Liked Songs", Tracks[i].title)
end

function loadTrack(i)
    index = i
    position = 0
    local t = Tracks[index]
    if not t then return end

    Title.Text = t.title
    Artist.Text = t.artist
    TimeL.Text = "0:00"
    TimeR.Text = fmt(t.length)
    setProgressVisual(0)
    tween(Art, 0.3, { BackgroundColor3 = t.color })
    Art.Image = ""
    ArtIcon.Visible = true

    if t.sound then
        Sound:Stop()
        Sound.SoundId = "rbxassetid://" .. tostring(t.sound)
        Sound.TimePosition = 0
        Sound.Looped = false
        if playing then
            Sound:Play()
        end
    else
        Sound:Stop()
        Sound.SoundId = ""
    end
    updateLike()
end

function setPlaying(state)
    playing = state
    setIcon(PlayIcon, playing and "pause" or "play")
    NowLabel.TextColor3 = playing and GREEN or GRAY
    NowLabel.Text = playing and "NOW PLAYING" or "PAUSED"

    local t = Tracks[index]
    if t and t.sound then
        if playing then
            Sound:Play()
        else
            Sound:Pause()
        end
    end
end

function seek(ratio)
    local t = Tracks[index]
    if not t then return end
    position = math.clamp(ratio, 0, 1) * t.length
    if t.sound then Sound.TimePosition = position end
    setProgressVisual(position / t.length)
    TimeL.Text = fmt(position)
end

local function changeTrack(dir)
    if #currentVisibleTrackIndices == 0 then return end
    
    -- หา index ปัจจุบันในลิสต์ที่มองเห็น
    local currentPos = 1
    for k, v in ipairs(currentVisibleTrackIndices) do
        if v == index then currentPos = k; break end
    end

    local n
    if shuffleOn and #currentVisibleTrackIndices > 1 then
        repeat n = currentVisibleTrackIndices[math.random(1, #currentVisibleTrackIndices)] until n ~= index
    else
        local nextIdx = ((currentPos - 1 + dir) % #currentVisibleTrackIndices) + 1
        n = currentVisibleTrackIndices[nextIdx]
    end
    loadTrack(n)
end

function setPlayerOpen(state)
    playerOpened = state
    if state then
        Root.Visible = true
        RootScale.Scale = 0.5
        tween(RootScale, 0.4, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        tween(ToggleIcon, 0.2, { ImageTransparency = 0 })
        tween(ToggleFallback, 0.2, { ImageTransparency = 0 })
    else
        tween(RootScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(ToggleIcon, 0.2, { ImageTransparency = 0.45 })
        tween(ToggleFallback, 0.2, { ImageTransparency = 0.45 })
        task.delay(0.22, function() if not playerOpened then Root.Visible = false end end)
    end
end

local function setDrawerOpen(state)
    drawerOpened = state
    if state then EdgeGlow.Visible = true end
    tween(Drawer, 0.5, { Position = UDim2.new(0, state and 0 or -DW, 0, 0) }, Enum.EasingStyle.Quint)
    tween(TabArrow, 0.35, { Rotation = state and 180 or 0 })
    if not state then
        AddPanel.Visible = false
        task.delay(0.5, function() if not drawerOpened then EdgeGlow.Visible = false end end)
    end
end

