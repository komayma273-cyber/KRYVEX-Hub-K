local function setIcon(img, name)
    if not Lucide then return false end
    local ok, a = pcall(function() return Lucide.GetAsset(name, 48) end)
    if ok and a then
        img.Image = a.Url
        img.ImageRectSize = a.ImageRectSize
        img.ImageRectOffset = a.ImageRectOffset
        return true
    end
    return false
end

