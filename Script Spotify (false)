Shuffle.MouseEnter:Connect(function() if not shuffleOn then tween(ShuffleIcon, 0.1, { ImageColor3 = WHITE }) end end)
Shuffle.MouseLeave:Connect(function() tween(ShuffleIcon, 0.1, { ImageColor3 = shuffleOn and GREEN or GRAY }) end)
Repeat.MouseEnter:Connect(function() if repeatMode == 0 then tween(RepeatIcon, 0.1, { ImageColor3 = WHITE }) end end)
Repeat.MouseLeave:Connect(function() tween(RepeatIcon, 0.1, { ImageColor3 = repeatMode == 1 and GREEN or GRAY }) end)
Like.MouseEnter:Connect(function() if not liked[index] then tween(LikeIcon, 0.1, { ImageColor3 = WHITE }) end end)
Like.MouseLeave:Connect(function() tween(LikeIcon, 0.1, { ImageColor3 = liked[index] and GREEN or GRAY }) end)
Close.MouseEnter:Connect(function() tween(CloseIcon, 0.1, { ImageColor3 = WHITE }) end)
Close.MouseLeave:Connect(function() tween(CloseIcon, 0.1, { ImageColor3 = GRAY }) end)

local function barHover(on)
    Fill.BackgroundColor3 = (on or scrubbing) and GREEN or WHITE
    Knob.BackgroundTransparency = (on or scrubbing) and 0 or 1
end
BarHit.MouseEnter:Connect(function() barHover(true) end)
BarHit.MouseLeave:Connect(function() barHover(false) end)
local function scrubTo(x) seek((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X) end
BarHit.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        scrubbing = true; barHover(true); scrubTo(i.Position.X)
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if scrubbing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then scrubTo(i.Position.X) end
end)
UserInputService.InputEnded:Connect(function(i)
    if scrubbing and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
        scrubbing = false; barHover(false)
    end
end)

--========= MAIN LOOP =========--
local clock = 0
RunService.Heartbeat:Connect(function(dt)
    clock = clock + dt
    StrokeGrad.Rotation = (clock * 80) % 360
    EdgeGrad.Offset = Vector2.new(0, ((clock * 0.45) % 2) - 1)
    EdgeGlow.BackgroundTransparency = 0.05 * math.sin(clock * 2)

    if drawerOpened then
        TabArrow.Position = UDim2.new(0, 26, 0.5, 0)
    else
        TabArrow.Position = UDim2.new(0, 26 + 3 * math.sin(clock * 4), 0.5, 0)
    end

    if playing then
        Glow1.BackgroundTransparency = 0.86 + 0.05 * math.sin(clock * 3)
        Glow2.BackgroundTransparency = 0.94 + 0.03 * math.sin(clock * 3 + 1)
        for n, bar in ipairs(EqBars) do
            bar.Size = UDim2.fromOffset(3, 3 + 10 * math.abs(math.sin(clock * (3 + n * 1.3) + n * 1.7)))
        end
    else
        Glow1.BackgroundTransparency = 0.92
        Glow2.BackgroundTransparency = 0.97
        for _, bar in ipairs(EqBars) do bar.Size = UDim2.fromOffset(3, 3) end
    end

    local r = Rows[index]
    if r then
        for n, bar in ipairs(r.bars) do
            local h = playing and (4 + 18 * math.abs(math.sin(clock * (3 + n * 1.4) + n * 1.9))) or 4
            bar.Size = UDim2.fromOffset(3, h)
        end
    end

    if not playing or scrubbing then return end
    local t = Tracks[index]
    if not t then return end
    if t.sound and Sound.IsPlaying then
        position = Sound.TimePosition
    else
        position = position + dt
    end
    if position >= t.length then
        if repeatMode == 1 then
            seek(0)
        else
            changeTrack(1)
        end
        return
    end
    setProgressVisual(position / t.length)
    TimeL.Text = fmt(position)
end)

