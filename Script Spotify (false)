local function rebuildTracks()
    Tracks = {}
    for i, s in ipairs(SongList) do
        Tracks[i] = {
            title = s.name,
            artist = s.category or "อื่นๆ",
            length = s.length or 180,
            sound = s.id,
            category = s.category or "อื่นๆ",
            color = COLORS[((i - 1) % #COLORS) + 1],
            status = s.status,
        }
    end
end
