local function buildCategories()
    for _, btn in ipairs(CatButtons) do btn:Destroy() end
    CatButtons = {}
    
    for idx, catName in ipairs(Categories) do
        local isActive = (activeCategory == catName)
        local cb = new("TextButton", {
            Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = isActive and GREEN or FIELD,
            Text = "  " .. catName .. "  ", Font = Enum.Font.GothamBold, TextSize = 11,
            TextColor3 = isActive and BLACK or WHITE, AutoButtonColor = false, ZIndex = 4, LayoutOrder = idx
        }, CatScroll)
        corner(cb, 14)
        table.insert(CatButtons, cb)
        
        cb.MouseButton1Click:Connect(function()
            activeCategory = catName
            onlyLiked = false
            setPillStyle()
            buildCategories()
            applyFilter() -- อัปเดตลิสต์
            
            -- 🔴 บังคับเปลี่ยนเพลงเป็นเพลงแรกของหมวดหมู่ใหม่ทันที
            local firstInCat = nil
            for i, t in ipairs(Tracks) do
                if t.category == activeCategory then
                    firstInCat = i
                    break
                end
            end
            if firstInCat then
                loadTrack(firstInCat)
                if playing then setPlaying(true) end
            end
        end)
    end
end

