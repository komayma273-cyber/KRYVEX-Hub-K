--========= ID CHECKER =========--
local function checkSoundId(id)
    if not id or id == "" then return false end
    local testSound = Instance.new("Sound")
    testSound.SoundId = "rbxassetid://" .. tostring(id)
    testSound.Parent = Gui

    local loaded = false
    local conn = testSound.Loaded:Connect(function() loaded = true end)

    local startTime = tick()
    while not loaded and tick() - startTime < 3 do
        if testSound.IsLoaded then loaded = true break end
        RunService.Heartbeat:Wait()
    end

    conn:Disconnect()
    testSound:Destroy()
    return loaded
end

