--========= HELPERS =========--
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function fmt(s)
    s = math.max(0, math.floor(s))
    return string.format("%d:%02d", math.floor(s / 60), s % 60)
end
local function tween(o, t, props, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function label(parent, props)
    props.BackgroundTransparency = 1
    props.Font = props.Font or Enum.Font.Gotham
    props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
    props.ZIndex = props.ZIndex or 2
    return new("TextLabel", props, parent)
end
local function iconButton(parent, iconName, pos, btnSize, iconSize, color, anchor, z)
    z = z or 3
    local b = new("TextButton", {
        AnchorPoint = anchor or Vector2.new(0, 0), Position = pos,
        Size = UDim2.fromOffset(btnSize, btnSize), BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false, ZIndex = z,
    }, parent)
    local img = new("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(iconSize, iconSize), BackgroundTransparency = 1,
        ImageColor3 = color, ZIndex = z + 1,
    }, b)
    setIcon(img, iconName)
    return b, img
end
local function loadDecalInto(imageLabel, fallback, assetId)
    task.spawn(function()
        local texture
        pcall(function()
            local obj = game:GetObjects("rbxassetid://" .. assetId)[1]
            if obj then
                local d = (obj:IsA("Decal") or obj:IsA("Texture")) and obj or obj:FindFirstChildWhichIsA("Decal", true)
                if d then texture = d.Texture end
            end
        end)
        imageLabel.Image = texture or ("rbxassetid://" .. assetId)
        pcall(function() ContentProvider:PreloadAsync({ imageLabel }) end)
        task.wait(0.3)
        if imageLabel.IsLoaded and fallback then fallback.Visible = false end
    end)
end

